  const sidebar = document.getElementById('sidebar');
  const btn = document.getElementById('sidebarToggle');
  const collapsed = sidebar.classList.toggle('collapsed');
  btn.innerHTML = collapsed ? '&#8250;' : '&#8249;';
  localStorage.setItem('sidebarCollapsed', collapsed);
}

// Restore sidebar state
(function() {
  if (localStorage.getItem('sidebarCollapsed') === 'true') {
    setTimeout(function() {
      const sidebar = document.getElementById('sidebar');
      const btn = document.getElementById('sidebarToggle');
      if (sidebar && btn) {
        sidebar.classList.add('collapsed');
        btn.innerHTML = '&#8250;';
      }
    }, 100);
  }
})();

function autosave() {
  try {
    localStorage.setItem(LS_KEY, JSON.stringify({
      entries, masterLocations, masterDescriptions,
      taxRate, deductionRate, hideNetPay, defaultPayRate,
      backupReminderEnabled, backupReminderDays, customShiftTimes
    }));
  } catch(e) { console.warn('Autosave failed:', e); }
}

function autoload() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) return false;
    const d = JSON.parse(raw);
    if (d.entries) Object.keys(d.entries).forEach(y => { entries[y] = d.entries[y]; });
    if (d.masterLocations) masterLocations = d.masterLocations;
    if (d.masterDescriptions) masterDescriptions = d.masterDescriptions;
    if (typeof d.taxRate === 'number') taxRate = d.taxRate;
    if (typeof d.deductionRate === 'number') deductionRate = d.deductionRate;
    if (typeof d.hideNetPay === 'boolean') hideNetPay = d.hideNetPay;
    if (typeof d.defaultPayRate === 'number') defaultPayRate = d.defaultPayRate;
    if (d.customShiftTimes && typeof d.customShiftTimes === 'object') customShiftTimes = d.customShiftTimes;
    if (typeof d.backupReminderEnabled === 'boolean') backupReminderEnabled = d.backupReminderEnabled;
    if (typeof d.backupReminderDays === 'number') backupReminderDays = d.backupReminderDays;
    if (d.customShiftTimes && typeof d.customShiftTimes === 'object') customShiftTimes = d.customShiftTimes;
    return true;
  } catch(e) { console.warn('Autoload failed:', e); return false; }
}

ensureAllIds();
populateShiftDropdowns();

// Auto-check for updates silently on startup
setTimeout(async function() {
  try {
    const res = await fetch(VERSION_URL + '?t=' + Date.now());
    const data = await res.json();
    if (data.version && data.version !== APP_VERSION) {
      showToast('Update available: v' + data.version + ' — click ⟳ to download', 'green');
      const btn = document.getElementById('updateBtn');
      if (btn) { btn.style.color = 'var(--yellow)'; btn.style.borderColor = 'var(--yellow)'; }
    }
  } catch(e) { /* silent fail - user may be offline */ }
}, 3000);

// Load from localStorage if available, otherwise use hardcoded data
const loaded = autoload();
checkBackupReminder();
ensureAllIds();

renderYearTabs();

// Set to most recent numeric year
const availYears = Object.keys(entries).filter(y => !isNaN(y)).map(Number).sort((a,b)=>a-b);
setYear(availYears[availYears.length - 1]);
</script>
</body>
</html>
