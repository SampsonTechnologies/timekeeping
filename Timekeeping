async function geminiImport() {
  if (!geminiApiKeyVal) {
    showToast('Please enter and save your Gemini API key first.', 'red');
    return;
  }
  const text = document.getElementById('geminiInput').value.trim();
  if (!text) { showToast('Please describe your shifts first.', 'red'); return; }

  const btn = document.getElementById('geminiImportBtn');
  const resultEl = document.getElementById('geminiResult');
  btn.textContent = '⏳ Parsing...';
  btn.disabled = true;
  resultEl.style.display = 'none';

  const today = new Date().toISOString().slice(0,10);
  const prompt = `You are a shift parser for a timekeeping app. Parse the following shift description and return ONLY a JSON array of shift objects. No explanation, no markdown, just raw JSON.

Each object must have these fields:
- date: string in YYYY-MM-DD format
- loc: string (location name)
- shift: string in HHMM-HHMM format (24hr, e.g. "1400-2200")
- hrs: number (hours worked, calculate from shift if not stated)
- rate: number (hourly pay rate, use 26 if not stated)
- desc: null or string (description if mentioned)

Today's date is ${today}. Use this to resolve relative dates like "Monday" or "next week".

Known locations for reference (use closest match): ${masterLocations.slice(0,10).join(', ')}

Shift description to parse:
"${text}"

Return only the JSON array, nothing else.`;

  try {
    const res = await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=' + geminiApiKeyVal, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: { temperature: 0.1 }
      })
    });

    const data = await res.json();
    if (data.error) throw new Error(data.error.message);

    let raw = data.candidates[0].content.parts[0].text.trim();
    // Strip markdown if present
    raw = raw.replace(/^```json\n?/, '').replace(/\n?```$/, '').trim();

    const shifts = JSON.parse(raw);
    if (!Array.isArray(shifts) || shifts.length === 0) throw new Error('No shifts parsed');

    let added = 0;
    shifts.forEach(s => {
      const year = parseInt((s.date || '').slice(0,4));
      if (!year || isNaN(year)) return;
      if (!entries[year]) entries[year] = [];
      entries[year].push({ date: s.date, loc: s.loc || '', shift: s.shift || '', hrs: Number(s.hrs) || 0, rate: Number(s.rate) || defaultPayRate, desc: s.desc || null });
      entries[year].sort((a, b) => {
        if (a.date !== b.date) return a.date.localeCompare(b.date);
        return ((a.shift||'').split('-')[0]||'').localeCompare((b.shift||'').split('-')[0]||'');
      });
      added++;
    });

    ensureAllIds();
    renderYearTabs();
    setYear(currentYear);
    autosave();

    resultEl.style.display = 'block';
    resultEl.style.color = 'var(--green)';
    resultEl.textContent = '✓ ' + added + ' shift' + (added===1?'':'s') + ' imported successfully!';
    document.getElementById('geminiInput').value = '';

  } catch(e) {
    resultEl.style.display = 'block';
    resultEl.style.color = 'var(--red)';
    resultEl.textContent = '✗ Error: ' + e.message;
  } finally {
    btn.textContent = '🤖 Parse & Import with AI';
    btn.disabled = false;
  }
}

function processBulkImport() {
  const raw = document.getElementById('bulkImportText').value.trim();
  const resultEl = document.getElementById('bulkImportResult');
  if (!raw) { resultEl.style.display='none'; return; }

  const lines = raw.split('\n').map(l => l.trim()).filter(l => l && !l.startsWith('#'));
  let added = 0, skipped = 0, errors = [];

  lines.forEach((line, i) => {
    const parts = line.split('|').map(p => p.trim());
    if (parts.length < 3) { errors.push('Line ' + (i+1) + ': need at least DATE | LOCATION | SHIFT'); skipped++; return; }

    const date = parts[0];
    const loc = parts[1];
    const shift = parts[2];
    let hrs = parts[3] ? parseFloat(parts[3]) : null;
    const rate = parts[4] ? parseFloat(parts[4]) : defaultPayRate;

    // Validate date format
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) { errors.push('Line ' + (i+1) + ': invalid date "' + date + '" — use YYYY-MM-DD'); skipped++; return; }
    if (!loc) { errors.push('Line ' + (i+1) + ': missing location'); skipped++; return; }

    // Auto-calculate hours from shift if not provided
    if (!hrs || isNaN(hrs)) {
      const sp = shift.split('-');
      if (sp.length === 2) {
        const toMins = t => { t = t.trim(); if (t.length === 3) t = '0'+t; return parseInt(t.slice(0,2))*60+parseInt(t.slice(2,4)); };
        let sm = toMins(sp[0]), em = toMins(sp[1]);
        if (em <= sm) em += 1440;
        hrs = Math.round((em - sm) / 60 * 100) / 100;
      } else { hrs = 0; }
    }

    const year = parseInt(date.slice(0,4));
    if (!entries[year]) entries[year] = [];
    entries[year].push({ date, loc, shift, hrs, rate, desc: null });

    // Sort after adding
    entries[year].sort((a, b) => {
      if (a.date !== b.date) return a.date.localeCompare(b.date);
      const aS = (a.shift||'').split('-')[0]||'';
      const bS = (b.shift||'').split('-')[0]||'';
      return aS.localeCompare(bS);
    });
    added++;
  });

  ensureAllIds();
  renderYearTabs();
  setYear(currentYear);
  autosave();

  resultEl.style.display = 'block';
  if (added > 0 && errors.length === 0) {
    resultEl.style.color = 'var(--green)';
    resultEl.textContent = '✓ ' + added + ' shift' + (added===1?'':'s') + ' imported successfully!';
    document.getElementById('bulkImportText').value = '';
  } else if (added > 0) {
    resultEl.style.color = 'var(--yellow)';
    resultEl.textContent = '⚠ ' + added + ' imported, ' + skipped + ' skipped. ' + errors.join(' | ');
  } else {
    resultEl.style.color = 'var(--red)';
    resultEl.textContent = '✗ ' + errors.join(' | ');
  }
}
