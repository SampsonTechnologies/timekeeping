function addYear() {
  if (entries['NEW']) { showToast('Rename the existing new year first.', 'red'); return; }
  // Find the highest numeric year and add the next one
  const numericYears = Object.keys(entries).filter(y => !isNaN(y)).map(Number);
  let newYear;
  if (numericYears.length === 0) {
    newYear = new Date().getFullYear();
  } else {
    newYear = Math.max(...numericYears) + 1;
  }
  if (entries[newYear]) { showToast('Year ' + newYear + ' already exists.', 'red'); return; }
  entries[newYear] = [];
  currentYear = newYear;
  sidebarMonth = 'ALL';
  currentPP = 0;
  renderYearTabs();
  render();
  autosave();
  showToast('Year ' + newYear + ' added ✓', 'green');
}

