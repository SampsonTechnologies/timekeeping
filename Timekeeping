function getExportEntries() {
  const scope = document.querySelector('input[name="exportScope"]:checked').value;
  let result = [];
  if (scope === 'all') {
    Object.keys(entries).map(Number).sort((a,b)=>a-b).forEach(y => {
      (entries[y]||[]).forEach(e => result.push({...e, year: y}));
    });
  } else if (scope === 'year') {
    (entries[currentYear]||[]).forEach(e => result.push({...e, year: currentYear}));
  } else {
    const year = parseInt(document.getElementById('exportYearSelect').value);
    const checked = [...document.querySelectorAll('#exportMonthCheckboxes input:checked')].map(i => i.value);
    (entries[year]||[]).filter(e => checked.includes(e.date.slice(0,7))).forEach(e => result.push({...e, year}));
  }
  return result;
}

function doExport(fmt) {
  const exportEntries = getExportEntries();
  if (exportEntries.length === 0) { showToast('No entries to export.', 'red'); return; }
  if (fmt === 'xlsx') exportXlsx(exportEntries);
  else if (fmt === 'pdf') exportPdf(exportEntries);
  else exportPrint(exportEntries);
}

function exportXlsx(data) {
  // Group by year, build CSV-style then trigger download as Excel-compatible TSV
  const years = [...new Set(data.map(e => e.year))].sort();
  let wb = '';
  years.forEach(y => {
    const yearData = data.filter(e => e.year === y);
    const pps = getPayPeriods(y);
    wb += 'YEAR: ' + y + '\n';
    wb += 'Date\tLocation\tShift\tHours\tRate\tEarnings\tDescription\n';
    // Group by pay period
    pps.forEach((pp, i) => {
      const ppEntries = pp.entries.filter(e => yearData.some(d => d.date === e.date && d.loc === e.loc && d.shift === e.shift));
      if (ppEntries.length === 0) return;
      ppEntries.forEach(e => {
        const earn = (Number(e.hrs) * Number(e.rate)).toFixed(2);
        wb += `${e.date}\t${e.loc}\t${e.shift||''}\t${Number(e.hrs).toFixed(2)}\t$${Number(e.rate).toFixed(2)}\t$${earn}\t${e.desc||''}\n`;
      });
      wb += `Pay Period ${i+1} Total\t\t\t${pp.totalHrs.toFixed(2)}\t\t$${pp.totalEarn.toFixed(2)}\t${pp.needed===0?'OT: +'+pp.ot.toFixed(2)+'h':'Short: -'+pp.needed.toFixed(2)+'h'}\n`;
      wb += '\n';
    });
    wb += '\n';
  });
  const blob = new Blob([wb.replace(/\t/g, ',')], {type: 'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'timekeeping_export.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 2000);
}

function buildReportHtml(data, autoPrint) {
  const years = [...new Set(data.map(e => e.year))].sort();
  const MN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  let html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Timekeeping Report</title>
  <style>
    body{font-family:'Courier New',monospace;font-size:11px;color:#000;margin:20px;}
    h1{font-size:18px;margin-bottom:4px;}
    h2{font-size:14px;margin:16px 0 6px;border-bottom:2px solid #000;padding-bottom:2px;}
    h3{font-size:11px;margin:12px 0 4px;color:#444;background:#f0f0f0;padding:3px 6px;}
    table{width:100%;border-collapse:collapse;margin-bottom:8px;}
    th{background:#222;color:#fff;padding:4px 8px;text-align:left;font-size:10px;}
    td{padding:3px 8px;border-bottom:1px solid #ddd;font-size:10px;}
    .total-row{background:#f5f5f5;font-weight:bold;}
    .ot{color:green;}.short{color:red;}
    .deficit-row{background:#fff3cd;}
    @media print{body{margin:10px;}}
  </style></head><body>
  <h1>TIMEKEEPING REPORT</h1>
  <p style="color:#666;margin-bottom:16px">Generated: ${new Date().toLocaleDateString()}</p>`;
  years.forEach(y => {
    const pps = getPayPeriods(y);
    const yearEntries = data.filter(e => e.year === y);
    if (yearEntries.length === 0) return;
    const yearTotal = yearEntries.reduce((s,e) => s+Number(e.hrs), 0);
    const yearEarn = yearEntries.reduce((s,e) => s+Number(e.hrs)*Number(e.rate), 0);
    html += `<h2>${y} - ${yearTotal.toFixed(1)} hrs - $${yearEarn.toFixed(2)} gross</h2>`;
    let runningDeficit = 0;
    pps.forEach((pp, i) => {
      const ppDates = new Set(yearEntries.map(e => e.date+e.loc+e.shift));
      const ppEntries = pp.entries.filter(e => ppDates.has(e.date+e.loc+e.shift));
      if (ppEntries.length === 0) return;
      const priorDef = runningDeficit;
      const target = 40 + priorDef * 1.5;
      const needed = Math.max(0, target - pp.totalHrs);
      const ot = Math.max(0, pp.totalHrs - target);
      if (pp.totalHrs < 40) runningDeficit += (40 - pp.totalHrs) / 1.5;
      else if (pp.totalHrs > 40 && runningDeficit > 0) runningDeficit = Math.max(0, runningDeficit - (pp.totalHrs - 40));
      const ppMonth = pp.entries[0]?.date?.slice(0,7);
      const monthName = ppMonth ? MN[parseInt(ppMonth.split('-')[1])-1] : '';
      html += `<h3>PP ${i+1} | ${pp.dateRange} | ${monthName}</h3>`;
      html += `<table><thead><tr><th>Date</th><th>Location</th><th>Shift</th><th>Hours</th><th>Rate</th><th>Description</th></tr></thead><tbody>`;
      ppEntries.forEach(e => {
        html += `<tr><td>${e.date}</td><td>${e.loc}</td><td>${e.shift||''}</td><td>${fmtHrs(e.hrs)}</td><td>$${Number(e.rate).toFixed(2)}</td><td>${e.desc||''}</td></tr>`;
      });
      const sc = needed===0?'ot':'short';
      const st = needed===0?`OT: +${ot.toFixed(1)}h`:`Short: -${needed.toFixed(1)}h`;
      html += `<tr class="total-row"><td colspan="3"><b>PP ${i+1} Total</b></td><td><b>${fmtHrs(pp.totalHrs)}</b></td><td></td><td class="${sc}"><b>${st}</b></td></tr>`;
      if (priorDef > 0) html += `<tr class="deficit-row"><td colspan="7">Deficit carried in: ${priorDef.toFixed(1)} OT hrs - Target: ${target.toFixed(1)} hrs</td></tr>`;
      html += `</tbody></table>`;
    });
  });
  html += `<div style="position:sticky;top:0;background:#111;padding:8px 16px;display:flex;gap:10px;align-items:center;z-index:999"><span style="color:#00e5ff;font-family:monospace;font-weight:600">TIMEKEEPING REPORT</span><button onclick="window.print()" style="margin-left:auto;background:#00e5ff;color:#000;border:none;padding:6px 16px;border-radius:4px;font-family:monospace;font-weight:600;cursor:pointer">Print / Save PDF</button></div>`;
  html += `</body></html>`;
  return html;
}

function exportPdf(data) {
  openReport(buildReportHtml(data));
}

function exportPrint(data) {
  openReport(buildReportHtml(data));
}

function openReport(html) {
  const blob = new Blob([html], {type: 'text/html'});
  const url = URL.createObjectURL(blob);
