function saveEntry() {
  const date  = document.getElementById('fDate').value;
  const hrs   = parseFloat(document.getElementById('fHours').value);
  const locSel = document.getElementById('fLocation').value;
  const locOtherVal = document.getElementById('fLocOther').value.trim();
  // If fLocOther has content, always use it (handles cases where dropdown reverted)
  const loc = (locSel === 'Other' || locOtherVal)
    ? (locOtherVal || null)
    : locSel;
  const shiftStart = document.getElementById('fShiftStart').value.trim();
  const shiftEnd = document.getElementById('fShiftEnd').value.trim();
  const shift = shiftStart && shiftEnd ? `${shiftStart}-${shiftEnd}` : (shiftStart || shiftEnd || '');
  const rate  = parseFloat(document.getElementById('fRate').value);
  const descSel = document.getElementById('fDesc').value;
  const desc = descSel === 'Other'
    ? (document.getElementById('fDescOther').value.trim() || null)
    : (descSel || null);

  if (!date || isNaN(hrs) || !loc || isNaN(rate)) {
    showToast('Please fill in all required fields.', 'red');
    return;
  }

  const entry = { date, loc, shift, hrs, rate, desc };

  // Remember which pay period we're viewing (by its start date, not index)
  const ppsBefore = getPayPeriods(currentYear);
  const viewingPPStart = (ppsBefore[currentPP] || {}).ppStart;

  // Always remove old entry first (if editing), then re-insert and re-sort
  const arr = entries[currentYear];
  if (editingIdx !== null) {
    arr.splice(editingIdx, 1); // remove old entry
  }
  arr.push(entry); // add new entry
  // Sort by date, then by start time within the same date
  arr.sort((a, b) => {
    if (a.date !== b.date) return a.date.localeCompare(b.date);
    const aStart = (a.shift || '').split('-')[0] || '';
    const bStart = (b.shift || '').split('-')[0] || '';
    return aStart.localeCompare(bStart);
  });

  closeModal();

  const wasEditing = editingIdx !== null;
  ensureAllIds();
  const ppsAfter = getPayPeriods(currentYear);

  if (wasEditing && viewingPPStart) {
    // Restore the same pay period by matching its start date
    const match = ppsAfter.findIndex(p => p.ppStart === viewingPPStart);
    currentPP = match !== -1 ? match : Math.min(currentPP, ppsAfter.length - 1);
  } else {
    // New entry — jump to the pay period containing the new entry's date
    const entryPPStart = getPayPeriodStart(entry.date);
    const match = ppsAfter.findIndex(p => p.ppStart === entryPPStart);
    currentPP = match !== -1 ? match : getCurrentPP(currentYear);
  }

  render();
  autosave();
}

let pendingDeleteId = null;
let pendingDeleteTimer = null;
let lastDeleted = null; // { entry, yearKey, idx, timer }

function showUndoToast() {
  let toast = document.getElementById('undoToast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'undoToast';
    toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px 20px;display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12px;color:var(--text);z-index:9999;box-shadow:0 8px 30px rgba(0,0,0,0.5);transition:opacity .3s';
    document.body.appendChild(toast);
  }
  toast.innerHTML = '<span>Entry deleted</span><button onclick="undoDelete()" style="background:var(--accent);color:#000;border:none;padding:5px 14px;border-radius:4px;font-family:var(--mono);font-size:12px;font-weight:600;cursor:pointer">Undo</button>';
  toast.style.opacity = '1';
  toast.style.display = 'flex';
  if (lastDeleted && lastDeleted.timer) clearTimeout(lastDeleted.timer);
  if (lastDeleted) lastDeleted.timer = setTimeout(() => {
    toast.style.opacity = '0';
    setTimeout(() => { toast.style.display = 'none'; lastDeleted = null; }, 300);
  }, 5000);
}

function undoDelete() {
  if (!lastDeleted) return;
  clearTimeout(lastDeleted.timer);
  const { entry, yearKey, idx } = lastDeleted;
  lastDeleted = null;
  const arr = entries[yearKey] || [];
  arr.splice(idx, 0, entry);
  const toast = document.getElementById('undoToast');
  if (toast) { toast.style.opacity = '0'; setTimeout(() => { toast.style.display = 'none'; }, 300); }
  render();
  autosave();
}

function confirmDeleteEntryById(eid, btn, event) {
  event.stopPropagation();
  if (pendingDeleteId === eid) {
    clearTimeout(pendingDeleteTimer);
    pendingDeleteId = null;
    const arr = entries[currentYear] || [];
    const idx = arr.findIndex(e => e._id === eid);
    if (idx !== -1) arr.splice(idx, 1);
    render();
  } else {
    if (pendingDeleteId !== null) {
      const oldBtn = document.getElementById('delbtn-' + pendingDeleteId);
      if (oldBtn) { oldBtn.textContent = '✕'; oldBtn.style.borderColor = ''; oldBtn.style.color = ''; }
    }
    clearTimeout(pendingDeleteTimer);
    pendingDeleteId = eid;
    btn.id = 'delbtn-' + eid;
    btn.textContent = '?';
    btn.style.borderColor = 'var(--red)';
    btn.style.color = 'var(--red)';
    pendingDeleteTimer = setTimeout(() => {
      pendingDeleteId = null;
      if (btn) { btn.textContent = '✕'; btn.style.borderColor = ''; btn.style.color = ''; }
    }, 3000);
  }
}

