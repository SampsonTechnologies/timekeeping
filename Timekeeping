  // Render month pills (scrollable)
  const monthBtns = months.map(m => {
    const label = MONTH_NAMES[parseInt(m.split('-')[1]) - 1];
    return `<button class="month-btn ${sidebarMonth === m ? 'active' : ''}" onclick="setMonthFilter('${m}')" data-month="${m}">${label}</button>`;
  }).join('');
