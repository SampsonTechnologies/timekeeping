function savePTO() {
  const date = document.getElementById('ptoDate').value;
  const hrs = parseFloat(document.getElementById('ptoHrs').value);
  const rate = parseFloat(document.getElementById('ptoRate').value) || defaultPayRate;
  const desc = document.getElementById('ptoDesc').value.trim() || 'PTO';

  if (!date || !/^\d{4}-\d{2}-\d{2}$/.test(date)) { showToast('Enter a valid date.', 'red'); return; }
  if (!hrs || isNaN(hrs) || hrs <= 0) { showToast('Enter valid hours.', 'red'); return; }

  const year = parseInt(date.slice(0,4));
  if (!entries[year]) entries[year] = [];
  const entry = { date, loc: '', shift: '', hrs, rate, desc, type: 'PTO', _id: 'e' + Date.now() + Math.random().toString(36).slice(2,7) };
  entries[year].push(entry);
  entries[year].sort((a, b) => {
    if (a.date !== b.date) return a.date.localeCompare(b.date);
