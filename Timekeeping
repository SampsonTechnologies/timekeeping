// Exact hours from a full "HHMM-HHMM" shift (minutes included, 2 decimals). Overnight shifts supported.
function shiftToHours(shift) {
  const m = /^(\d{2})(\d{2})-(\d{2})(\d{2})$/.exec((shift || '').trim());
  if (!m) return null;
  const sh = +m[1], sm = +m[2], eh = +m[3], em = +m[4];
  if (sh > 23 || eh > 23 || sm > 59 || em > 59) return null;
  const s = sh * 60 + sm;
  let e = eh * 60 + em;
  if (e <= s) e += 1440;
  return Math.round((e - s) / 60 * 100) / 100;
}

// Display hours: 8 -> "8.0", 2.5 -> "2.5", 2.25 -> "2.25"
function fmtHrs(h) {
  const r = Math.round((Number(h) || 0) * 100) / 100;
  return Number.isInteger(Math.round(r * 10 * 1000) / 1000) ? r.toFixed(1) : r.toFixed(2);
}

function qaSetHoursFromShift() {
  const sEl = document.getElementById('qaShift');
  const val = sEl.value.trim();
  // Hours were already derived from this exact shift text -> leave any manual hours edit alone
  if (sEl.dataset.hrsFrom === val) return;
  const h = shiftToHours(val);
  if (h !== null) {
    document.getElementById('qaHrs').value = h;
    sEl.dataset.hrsFrom = val;
  }
}

