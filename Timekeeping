// Typical shift start times by location prefix (8hr shifts)
const TYPICAL_SHIFTS = [
  { match: 'GDIT', shift: '0600-1400' },
  { match: 'GDMS', shift: '0700-1500' },
  { match: 'Leidos - Edgewood', shift: '0800-1600' },
  { match: 'Leidos Edgewood', shift: '0800-1600' },
  { match: 'Leidos', shift: '0700-1500' },
  { match: 'BAE', shift: '0800-1600' },
  { match: 'Peraton', shift: '0600-1400' },
  { match: 'Nightwing', shift: '0800-1600' }
];

function setLocationStartTime(input) {
  const loc = input.dataset.loc.replace(/&quot;/g, '"');
  const val = input.value.trim();
  if (val === '') {
    delete customShiftTimes[loc];
  } else if (/^\d{4}$/.test(val)) {
    customShiftTimes[loc] = val;
  } else {
    showToast('Enter a 4-digit time like 0600', 'red');
    return;
  }
  autosave();
}

function getTypicalShift(loc) {
  if (!loc) return null;
  // 1. Check user-set custom time first (exact match)
  if (customShiftTimes[loc]) {
    const start = customShiftTimes[loc];
    const h = parseInt(start.slice(0,2)), m = parseInt(start.slice(2,4));
    const endMins = (h * 60 + m + 480) % 1440;
    const endH = String(Math.floor(endMins / 60)).padStart(2,'0');
    const endM = String(endMins % 60).padStart(2,'0');
    return start + '-' + endH + endM;
  }
  // 2. Fall back to built-in prefix matches
  for (const t of TYPICAL_SHIFTS) {
    if (loc.toLowerCase().includes(t.match.toLowerCase())) return t.shift;
  }
  return null;
}

