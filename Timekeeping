// ── INLINE EDITING ───────────────────────────────────────────
function inlineEdit(id, field, value) {
  const arr = entries[currentYear] || [];
  const e = arr.find(x => String(x._id) === String(id));
  if (!e) return;

  // Capture current pay period start so we don't jump
  const ppsBefore = getPayPeriods(currentYear);
  const viewingPPStart = (ppsBefore[currentPP] || {}).ppStart;

  if (field === 'hrs' || field === 'rate') {
    const num = parseFloat(value);
    if (isNaN(num) || num < 0) { render(); return; }
    e[field] = num;
  } else if (field === 'date') {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) { render(); return; }
    e.date = value;
    // Date may move entry to a different year
    const newYear = parseInt(value.slice(0,4));
    if (newYear !== currentYear) {
      arr.splice(arr.indexOf(e), 1);
      if (!entries[newYear]) entries[newYear] = [];
      entries[newYear].push(e);
    }
  } else if (field === 'shift') {
    let v = value.trim();
    // Auto-complete 4-digit start to +8hr range
    if (/^\d{4}$/.test(v)) {
      const sm = parseInt(v.slice(0,2))*60 + parseInt(v.slice(2,4));
      const em2 = (sm + 480) % 1440;
      v = v + '-' + String(Math.floor(em2/60)).padStart(2,'0') + String(em2%60).padStart(2,'0');
    }
    e.shift = v;
    // Auto-calc hours from shift if valid range
    const calc = shiftToHours(v);
    if (calc !== null) e.hrs = calc;
  } else {
    e[field] = value;
  }

  // Re-sort the affected year
  const yr = parseInt(e.date.slice(0,4));
  if (entries[yr]) {
    entries[yr].sort((a, b) => {
      if (a.date !== b.date) return a.date.localeCompare(b.date);
      return ((a.shift||'').split('-')[0]||'').localeCompare((b.shift||'').split('-')[0]||'');
    });
  }

  // Restore the same pay period view
  const ppsAfter = getPayPeriods(currentYear);
  if (viewingPPStart) {
    const match = ppsAfter.findIndex(p => p.ppStart === viewingPPStart);
    if (match !== -1) currentPP = match;
    else currentPP = Math.min(currentPP, ppsAfter.length - 1);
  }

  render();
  autosave();
}

