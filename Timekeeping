<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Timekeeping</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d0f12;
    --surface: #151820;
    --surface2: #1c2030;
    --border: #252a38;
    --accent: #00e5ff;
    --accent2: #ff6b35;
    --green: #00c97a;
    --red: #ff4466;
    --yellow: #ffd166;
    --text: #e2e8f0;
    --muted: #6b7a99;
    --mono: 'IBM Plex Mono', monospace;
    --sans: 'IBM Plex Sans', sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    font-size: 14px;
  }

  /* === LAYOUT === */
  .app { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
  .header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 8px;
  }
  .header-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .header-right { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

  /* Mobile: hide status pills, shrink buttons */
  @media (max-width: 600px) {
    .header { padding: 8px 10px; gap: 6px; }
    #deficitPill { display: none; }
    .logo { font-size: 13px; }
    .btn-settings { width: 34px; height: 34px; font-size: 13px; }
    .year-tab { width: 44px; font-size: 10px; }
  }
  .logo {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .logo span { color: var(--muted); }
  .year-tabs { display: flex; gap: 4px; }
  .year-tab {
    font-family: var(--mono);
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all .15s;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .year-tab.active { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 600; }
  .year-tab:hover:not(.active) { border-color: var(--accent); color: var(--accent); }
  .btn-add-year {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 600;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border: 1px dashed var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .15s;
    flex-shrink: 0;
  }
  .btn-add-year:hover { border-color: var(--accent); color: var(--accent); }
  .btn-settings {
    font-size: 16px;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all .15s;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .btn-settings:hover { border-color: var(--accent); color: var(--accent); }

  .status-pill {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 6px;
    border: 2px solid;
    letter-spacing: 0.04em;
    min-width: 260px;
    text-align: center;
    transition: all .3s;
  }
  .status-pill.green { background: #00c97a18; border-color: var(--green); color: var(--green); }
  .status-pill.red   { background: #ff446618; border-color: var(--red);   color: var(--red); }

  .main { display: flex; flex: 1; overflow: hidden; }

  /* === SIDEBAR === */
  .sidebar {
    width: 260px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow-y: auto;
    transition: width 0.25s ease;
    position: relative;
  }
  .sidebar.collapsed {
    width: 0;
    overflow: hidden;
    border-right: none;
  }
  .sidebar-toggle {
    width: 14px;
    min-width: 14px;
    height: 100%;
    background: var(--surface);
    border: none;
    border-right: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--muted);
    flex-shrink: 0;
    transition: color 0.15s, background 0.15s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }
  .sidebar-toggle:hover { color: var(--accent); background: var(--surface2); }
  .sidebar-section { padding: 12px 0; border-bottom: 1px solid var(--border); }

  .month-btn {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    padding: 3px 7px;
    border-radius: 3px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all .12s;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .month-btn.active { background: var(--accent); color: #000; border-color: var(--accent); }
  .month-btn:hover:not(.active) { border-color: var(--accent); color: var(--accent); }
  .month-arrow {
    font-size: 18px;
    font-weight: 300;
    width: 20px;
    height: 24px;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    line-height: 1;
    transition: color .12s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .month-arrow:hover { color: var(--accent); }
  .sidebar-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    padding: 0 14px 8px;
    text-transform: uppercase;
  }
  .pp-item { min-height: 44px;
    padding: 8px 14px;
    cursor: pointer;
    border-left: 3px solid transparent;
    transition: all .12s;
    display: flex;
    justify-content: space-between;
    align-items: center;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .pp-item:hover { background: var(--surface2); }
  .pp-item.active { border-left-color: var(--accent); background: var(--surface2); }
  .pp-item .pp-label { font-family: var(--mono); font-size: 11px; color: var(--text); }
  .pp-item .pp-hrs {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
  }
  .pp-item .pp-hrs.over { color: var(--green); }
  .pp-item .pp-hrs.under { color: var(--red); }
  .pp-item .pp-hrs.exact { color: var(--yellow); }

  /* === CONTENT === */
  .content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

  .content-header {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background: var(--surface2);
  }
  .pp-title { font-family: var(--mono); font-size: 13px; font-weight: 600; }
  .pp-stats { display: flex; gap: 20px; }
  .stat { display: flex; flex-direction: column; align-items: flex-end; }
  .stat-val { font-family: var(--mono); font-size: 16px; font-weight: 600; }
  .stat-val.green { color: var(--green); }
  .stat-val.red   { color: var(--red); }
  .stat-val.yellow{ color: var(--yellow); }
  .stat-lbl { font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }

  .btn-add { min-height: 44px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    padding: 7px 16px;
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: opacity .15s;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .btn-add:hover { opacity: 0.85; }

  /* === TABLE === */
  .table-wrap { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; }
  thead th {
    background: var(--surface);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1;
  }
  tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background .1s;
    cursor: pointer;
  }
  tbody tr:hover { background: var(--surface2); }
  tbody td { padding: 9px 14px; font-size: 13px; }
  td.mono { font-family: var(--mono); font-size: 12px; }
  td.loc { color: var(--accent); font-size: 12px; }
  td.hrs { font-family: var(--mono); font-weight: 600; color: var(--yellow); }
  td.earn { font-family: var(--mono); color: var(--green); }
  td.desc { color: var(--muted); font-style: italic; font-size: 12px; }
  td.actions { text-align: right; }
  .btn-del {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 3px;
    cursor: pointer;
    font-family: var(--mono);
    transition: all .12s;
  }
  .btn-del:hover { border-color: var(--red); color: var(--red); }

  /* === MODAL === */
  .overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 100;
    align-items: center;
    justify-content: center;
  }
  .overlay.open { display: flex; }
  .modal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
  }
  .modal-title {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 20px;
    letter-spacing: 0.06em;
  }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-group.full { grid-column: 1 / -1; }
  .form-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .form-control {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 13px;
    padding: 8px 10px;
    outline: none;
    transition: border-color .15s;
    width: 100%;
  }
  .form-control:focus { border-color: var(--accent); }
  select.form-control option { background: var(--surface); }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
  .btn-cancel {
    font-family: var(--mono);
    font-size: 12px;
    padding: 8px 18px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 5px;
    cursor: pointer;
    transition: all .12s;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .btn-cancel:hover { border-color: var(--text); color: var(--text); }
  .btn-save {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 18px;
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: opacity .15s;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  .btn-save:hover { opacity: 0.85; }

  /* === SUMMARY PANEL === */


  /* scrollbar */
  @keyframes pulse-yellow {
    0%, 100% { opacity: 1; border-color: var(--yellow); color: var(--yellow); }
    50% { opacity: 0.4; border-color: var(--yellow); color: var(--yellow); }
  }
  .update-available {
    animation: pulse-yellow 2s ease-in-out infinite;
    border-color: var(--yellow) !important;
    color: var(--yellow) !important;
  }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--surface); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
  }
</style>
  <!-- Google Drive API -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script src="https://apis.google.com/js/api.js" async defer></script>
  <!-- Microsoft MSAL -->
  <script src="https://alcdn.msauth.net/browser/2.38.3/js/msal-browser.min.js"></script>
</head>
<body>
<div class="app">

  <!-- HEADER -->
  <div id="backupBanner" style="display:none;position:absolute;top:0;left:50%;transform:translateX(-50%);background:var(--yellow);color:#000;font-family:var(--mono);font-size:11px;font-weight:600;padding:6px 14px;border-radius:0 0 8px 8px;letter-spacing:0.05em;z-index:199;white-space:nowrap;display:none;align-items:center;gap:10px">&#9888; Backup overdue <button onclick="openSync();markBackupDone();document.getElementById('backupBanner').style.display='none'" style="background:#000;color:var(--yellow);border:none;padding:3px 10px;border-radius:4px;font-family:var(--mono);font-size:10px;font-weight:600;cursor:pointer">Back Up Now</button><button onclick="snoozeBackupReminder()" style="background:transparent;color:#000;border:1px solid #000;padding:3px 10px;border-radius:4px;font-family:var(--mono);font-size:10px;cursor:pointer">Remind me later</button><button onclick="snoozeBackupReminder()" style="background:transparent;border:none;color:#000;font-size:14px;cursor:pointer;padding:0 2px">&#10005;</button></div>
  <div id="updateBanner" style="display:none;position:absolute;top:0;left:50%;transform:translateX(-50%);background:var(--yellow);color:#000;font-family:var(--mono);font-size:11px;font-weight:600;padding:4px 18px;border-radius:0 0 8px 8px;letter-spacing:0.05em;cursor:pointer;z-index:200;white-space:nowrap" onclick="checkForUpdates()">&#8635; Update Available — Click to Download</div>
  <header class="header" style="position:relative">
    <div class="header-left">
      <div>
        <div class="logo">TIME<span>KEEPING</span></div>
        <div style="font-family:var(--mono);font-size: 10px;color:var(--muted);letter-spacing:0.04em;margin-top:2px;white-space:nowrap">&copy; 2026 Sampson Technologies &nbsp;·&nbsp; <span id="versionLabel">v1.4.4</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:4px" id="yearTabsWrap"></div>
      <button class="btn-add-year" onclick="addYear()" title="Add next year">+</button>
    </div>
    <div class="header-right">
      <div class="status-pill green" id="deficitPill" style="min-width:200px">✓ No Deficit</div>
      <button class="btn-settings" onclick="checkForUpdates()" title="Check for Updates" id="updateBtn">&#8635;</button>
      <button class="btn-settings" onclick="openSync()" title="Backup / Restore" id="syncBtn">&#8645;</button>
      <button class="btn-settings" onclick="openExport()" title="Export">&#8599;</button>
      <button class="btn-settings" onclick="openSettings()" title="Manage Lists">⚙</button>
    </div>
  <!-- Mobile status bar (shown on small screens) -->
  <div id="mobileStatus" style="display:none;background:var(--surface2);border-bottom:1px solid var(--border);padding:6px 14px;font-family:var(--mono);font-size:10px;gap:12px;flex-wrap:wrap">
    <span id="mobileDeficitPill" style="color:var(--green)"></span>
  </div>
  <style>
    @media (max-width: 600px) {
      #mobileStatus { display: flex !important; }
    }
  </style>
  </header>

  <div class="main">

    <!-- SIDEBAR: Pay Periods -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-section" style="padding:10px 14px">
        <div class="sidebar-label" style="padding:0 0 8px">Filter by Month</div>
        <div style="display:flex;align-items:center;gap:4px">
          <div id="monthAllBtn"></div>
          <button class="month-arrow" id="monthScrollLeft" onclick="scrollMonths(-1)">&#8249;</button>
          <div id="monthFilter" style="display:flex;gap:4px;overflow:hidden;flex:1;scroll-behavior:smooth"></div>
          <button class="month-arrow" id="monthScrollRight" onclick="scrollMonths(1)">&#8250;</button>
        </div>
      </div>
      <div class="sidebar-section">
        <div class="sidebar-label">Pay Periods</div>
        <div id="ppList"></div>
      </div>
    </aside>
    <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" title="Toggle sidebar">&#8249;</button>

    <!-- MAIN CONTENT -->
    <div class="content">
      <div class="content-header">
        <div class="pp-title" id="ppTitle">Select a pay period</div>
        <div class="pp-stats" id="ppStats"></div>
        <button class="btn-add" onclick="openModal()">+ Add Entry</button>
        <button class="btn-add" onclick="openPTOModal()" style="background:var(--surface2);color:var(--accent);border:1px solid var(--accent);margin-left:8px">+ PTO</button>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Location</th>
              <th>Shift</th>
              <th>Hours</th>
              <th>Rate</th>
              <th>Description</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="entryTable"></tbody>
        </table>
        <div class="empty-state" id="emptyState" style="display:none">No entries in this pay period.</div>
      </div>

      <!-- SUMMARY BAR -->
    </div>
  </div>
</div>

<!-- SYNC MODAL -->
<div class="overlay" id="syncOverlay">
  <div class="modal" style="width:640px;max-width:95vw">
    <div class="modal-title">&#9729; BACKUP &amp; RESTORE</div>

    <!-- LOCAL FILE — always visible -->
    <div style="margin-bottom:16px">
      <div style="display:flex;gap:8px">
        <button class="btn-cancel" onclick="localBackup()" style="flex:1;text-align:center">&#8659; Export JSON</button>
        <label class="btn-cancel" style="flex:1;text-align:center;cursor:pointer;padding:7px 16px">
          &#8657; Import JSON
          <input type="file" accept=".json" onchange="localRestore(event)" style="display:none">
        </label>
      </div>
      <div style="font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:6px">Save JSON to OneDrive or Google Drive for manual multi-device sync.</div>
    </div>

    <!-- COLLAPSIBLE SECTIONS -->

    <!-- Google Drive -->
    <div style="border-top:1px solid var(--border)">
      <button onclick="toggleSection('sectionGdrive')" style="width:100%;background:transparent;border:none;padding:10px 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--muted);letter-spacing:0.08em">
        GOOGLE DRIVE <span id="sectionGdriveIcon">&#8250;</span>
      </button>
      <div id="sectionGdrive" style="display:none;padding-bottom:12px">
        <div style="display:flex;gap:6px;margin-bottom:8px">
          <input type="text" class="form-control" id="gdriveClientIdInput" placeholder="Paste Google Client ID..." style="flex:1;font-size:11px">
          <button class="btn-save" onclick="saveGdriveClientId()" style="padding:7px 10px;white-space:nowrap">Save</button>
        </div>
        <div id="gdriveStatus" style="font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:8px">Not connected</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn-cancel" id="gdriveConnectBtn" onclick="gdriveConnect()" style="flex:1">Connect Google Drive</button>
          <button class="btn-save" id="gdriveBackupBtn" onclick="gdriveBackup()" style="flex:1;display:none">&#8659; Backup</button>
          <button class="btn-cancel" id="gdriveRestoreBtn" onclick="gdriveRestore()" style="flex:1;display:none">&#8657; Restore</button>
          <button class="btn-cancel" id="gdriveDisconnectBtn" onclick="gdriveDisconnect()" style="flex:1;display:none;color:var(--red);border-color:var(--red)">Disconnect</button>
        </div>
      </div>
    </div>

    <!-- OneDrive -->
    <div style="border-top:1px solid var(--border)">
      <button onclick="toggleSection('sectionOnedrive')" style="width:100%;background:transparent;border:none;padding:10px 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--muted);letter-spacing:0.08em">
        MICROSOFT ONEDRIVE <span id="sectionOnedriveIcon">&#8250;</span>
      </button>
      <div id="sectionOnedrive" style="display:none;padding-bottom:12px">
        <div style="display:flex;gap:6px;margin-bottom:8px">
          <input type="text" class="form-control" id="msalClientIdInput" placeholder="Paste Microsoft Client ID..." style="flex:1;font-size:11px">
          <button class="btn-save" onclick="saveMsalClientId()" style="padding:7px 10px;white-space:nowrap">Save</button>
        </div>
        <div id="onedriveStatus" style="font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:8px">Not connected</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
