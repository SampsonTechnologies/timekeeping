function clearAllData() {
  const confirmed = confirm(
    'WARNING: This will permanently delete ALL entries and years.\n\n' +
    'Your locations, descriptions, and settings will be kept.\n\n' +
    'This cannot be undone. Are you sure?'
  );
  if (!confirmed) return;
  // Wipe all entries and years
  Object.keys(entries).forEach(y => delete entries[y]);
  // Start fresh with current calendar year
  const thisYear = new Date().getFullYear();
  entries[thisYear] = [];
  currentYear = thisYear;
  sidebarMonth = 'ALL';
  currentPP = 0;
  // Wipe ALL timekeeping localStorage keys to prevent old data loading
  Object.keys(localStorage).filter(k => k.startsWith('timekeeping_')).forEach(k => localStorage.removeItem(k));
  autosave();
  closeSettings();
  renderYearTabs();
  render();
  showToast('All entries cleared. Locations and settings kept.', 'green');
}

