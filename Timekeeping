let locRenameLog = []; // renames made during this Settings session (for Undo)

function applyLocationRename(oldName, newName) {
  const i = masterLocations.indexOf(oldName);
  if (i !== -1) masterLocations[i] = newName;
  Object.keys(entries).forEach(y => {
    (entries[y] || []).forEach(e => { if (e.loc === oldName) e.loc = newName; });
  });
  if (customShiftTimes[oldName]) {
    customShiftTimes[newName] = customShiftTimes[oldName];
    delete customShiftTimes[oldName];
  }
}

function renameLocation(input) {
  const oldName = input.dataset.loc.replace(/&quot;/g, '"');
  const newName = input.value.trim();
  if (!newName || newName === oldName) { renderSettingsLists(); return; }
  if (masterLocations.some(l => l.toLowerCase() === newName.toLowerCase() && l !== oldName)) {
    showToast('That location name already exists.', 'red');
    renderSettingsLists();
    return;
  }
  applyLocationRename(oldName, newName);
  locRenameLog.push({ from: oldName, to: newName });
  renderSettingsLists();
  render();
  autosave();
  showToast('Renamed — existing entries updated ✓', 'green');
}

function removeLocation(loc) {
  masterLocations = masterLocations.filter(l => l !== loc);
  renderSettingsLists();
  autosave();
}

function addDescription() {
  const val = document.getElementById('newDescInput').value.trim();
  if (!val || masterDescriptions.includes(val)) return;
  masterDescriptions.push(val);
  document.getElementById('newDescInput').value = '';
  renderSettingsLists();
