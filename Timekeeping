  if (!last) return;
  const lastIdx = pps.length - 1;

  const mobileDP = document.getElementById('mobileDeficitPill');

  // Deficit pill — shows hours short (straight time) AND OT hours needed to clear it
  const currentDeficit = getDisplayDeficit(currentYear, lastIdx); // current week only reduces, never inflates
  const hoursShort = currentDeficit * 1.5; // straight-time gap
  const deficitPill = document.getElementById('deficitPill');
  if (currentDeficit === 0) {
    deficitPill.className = 'status-pill green';
    deficitPill.textContent = `${currentYear}: ✓ No Deficit`;
    if (mobileDP) { mobileDP.textContent = '✓ No Deficit'; mobileDP.style.color = 'var(--green)'; }
  } else {
    deficitPill.className = 'status-pill red';
    deficitPill.textContent = `Total deficit: ${hoursShort.toFixed(1)} hrs · requires ${currentDeficit.toFixed(1)} OT hrs`;
    if (mobileDP) { mobileDP.textContent = `Total: ${hoursShort.toFixed(1)} hrs · ${currentDeficit.toFixed(1)} OT hrs`; mobileDP.style.color = 'var(--red)'; }
  }
}

