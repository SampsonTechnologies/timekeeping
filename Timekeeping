<script>
// ============================================================
// DATA — imported from Excel
// ============================================================
// Master lists — shared across all years
const APP_VERSION = '1.4.4';
const UPDATE_URL = 'https://SampsonTechnologies.github.io/timekeeping/index.html';
const VERSION_URL = 'https://SampsonTechnologies.github.io/timekeeping/version.json';

let _nextId = 1;
function ensureIds(year) {
  (entries[year] || []).forEach(e => { if (!e._id) e._id = 'e' + (_nextId++) + Math.random().toString(36).slice(2,6); });
}
function ensureAllIds() {
  Object.keys(entries).forEach(y => ensureIds(y));
}

let customShiftTimes = {}; // { locationName: '0600' } user-set typical start times
let masterLocations = [
  'BAE - Rockville',
  'BAE Shredding - Rockville',
  'GDMS - Tech Drive - AJ',
  'GDMS Technology Drive',
  'GDIT - Hanover',
  'IQS - Aberdeen',
  'KBR - Columbia',
  'Leidos - Benjamin Franklin - Columbia',
  'Leidos - Columbia',
  'Leidos - Dorsey Drive - AJ',
  'Leidos - Quarry Drive - Edgewood',
  'Leidos Dorsey Drive - AJ',
  'Nightwing - NBP - AJ',
  'Peraton - Landover',
  'Peraton - NBP - AJ',
  'Peraton - Silver Spring',
  'Peraton - Tech Drive - AJ',
  'SCIS HQ'
];

let masterDescriptions = [
  'Inspection',
  'PTO Requested',
  'Training'
];

const RAW = {};

// ============================================================
// STATE
// ============================================================
let currentYear = 2026;
let sidebarMonth = 'ALL'; // 'ALL' or 'YYYY-MM'
let taxRate = 22;
let deductionRate = 0;
let hideNetPay = false;
let defaultPayRate = 26;
let currentPP = null; // index of selected pay period
let editingIdx = null; // row index in entries[] being edited

// entries keyed by year — start from Excel data, allow adding
let entries = { [new Date().getFullYear()]: [] };

// ============================================================
// PAY PERIOD LOGIC
// Each pay period = up to 20 entries, non-rolling
// ============================================================
function getPayPeriodStart(dateStr) {
  // Pay period: Fri–Thu. Find the Friday on or before this date.
  const d = new Date(dateStr + 'T12:00:00');
  const day = d.getDay(); // 0=Sun,1=Mon,...,5=Fri,6=Sat
  const daysFromFri = (day + 2) % 7; // days since last Friday
  const fri = new Date(d);
  fri.setDate(d.getDate() - daysFromFri);
  return fri.toISOString().slice(0, 10);
}

function getPayPeriods(year) {
  ensureIds(year);
  const data = [...(entries[year] || [])].sort((a, b) => a.date.localeCompare(b.date));
  if (data.length === 0) return [];

  // Group entries by their pay period start (Friday)
  const grouped = {};
  const order = [];
  data.forEach(e => {
    const ppStart = getPayPeriodStart(e.date);
    if (!grouped[ppStart]) { grouped[ppStart] = []; order.push(ppStart); }
    grouped[ppStart].push(e);
  });

  const periods = [];
  order.forEach(ppStart => {
    const slice = grouped[ppStart];
    const totalHrs = slice.reduce((s, e) => s + Number(e.hrs), 0);
    const totalEarn = slice.reduce((s, e) => s + Number(e.hrs) * Number(e.rate), 0);
    // Thu end date = ppStart + 6 days
    const fri = new Date(ppStart + 'T12:00:00');
    const thu = new Date(fri); thu.setDate(fri.getDate() + 6);
    const thuStr = thu.toISOString().slice(0, 10);
    periods.push({
      idx: periods.length,
      ppStart,
      entries: slice,
      totalHrs,
      totalEarn,
      ot: Math.max(0, totalHrs - 40),
      needed: Math.max(0, 40 - totalHrs),
      label: 'Pay Period ' + (periods.length + 1),
      dateRange: fmt(ppStart) + ' – ' + fmt(thuStr)
    });
  });
  return periods;
}

function fmt(d) {
  if (!d) return '';
  const parts = d.split('-');
  return `${parts[1]}/${parts[2]}`;
}

function fmtMoney(n) {
  return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

// Cumulative OT deficit for the year up to and including a given PP index
// Only grows when a period is under 40 hrs — never reduced by OT periods
// Shortfall converted to OT hours needed: shortfall / 1.5
function getCumulativeDeficit(year, upToPPIdx) {
  const pps = getPayPeriods(year);
  let deficit = 0;
  for (let i = 0; i <= upToPPIdx && i < pps.length; i++) {
    const hrs = pps[i].totalHrs;
    if (hrs < 40) {
      // Short week — deficit grows based on shortfall from 40 only
      deficit += (40 - hrs) / 1.5;
    } else if (hrs > 40 && deficit > 0) {
      // OT week — chip away at deficit with hours above 40, floor at 0
      deficit = Math.max(0, deficit - (hrs - 40));
    }
    // If deficit hits 0, it resets — any further OT doesn't bank
  }
  return deficit;
}

// Hybrid deficit for the live pill: completed weeks count fully, but the
// current (in-progress) week only counts its OT to REDUCE the deficit —
// it never adds to the deficit just because the week isn't fully logged yet.
function getDisplayDeficit(year, lastIdx) {
  const pps = getPayPeriods(year);
  let deficit = 0;
  for (let i = 0; i <= lastIdx && i < pps.length; i++) {
    const hrs = pps[i].totalHrs;
    const isCurrent = (i === lastIdx);
    if (hrs < 40) {
      if (!isCurrent) deficit += (40 - hrs) / 1.5; // only completed short weeks add
    } else if (hrs > 40 && deficit > 0) {
      deficit = Math.max(0, deficit - (hrs - 40)); // OT pays down (current week included)
    }
  }
  return deficit;
}

// Current (last) pay period
function getCurrentPP(year) {
  const pps = getPayPeriods(year);
  return pps.length - 1;
}

// ============================================================
// RENDER
// ============================================================
function renderYearTabs() {
  const tabs = Object.keys(entries).sort((a,b) => {
    if (a === 'NEW') return 1;
    if (b === 'NEW') return -1;
    return Number(a) - Number(b);
  });
  const tabsHtml = tabs.map(yr => {
    const isNew = yr === 'NEW';
    const isActive = yr === String(currentYear);
    return `<button class="year-tab ${isActive ? 'active' : ''}" data-yr="${yr}"
      onclick="setYear('${yr}')"
      ondblclick="renameYear('${yr}')"
      title="Double-click to rename"
      style="${isNew ? 'border-style:dashed;' : ''}"
    >  ${isNew ? 'New' : yr}</button>`;
  }).join('');
  const showArrows = tabs.length > 3;
  const container = document.getElementById('yearTabsWrap');
  container.innerHTML = (showArrows ? `<button class="month-arrow" onclick="scrollYearTabs(-1)">&#8249;</button>` : '') +
    `<div id="yearTabs" style="display:flex;gap:4px;overflow:hidden;${showArrows ? 'width:168px;' : ''}">${tabsHtml}</div>` +
    (showArrows ? `<button class="month-arrow" onclick="scrollYearTabs(1)">&#8250;</button>` : '');
}

function renameYear(oldKey) {
  var btn = document.querySelector('[data-yr="' + oldKey + '"]');
  if (!btn) return;
  var input = document.createElement('input');
  input.type = 'number';
  input.value = oldKey === 'NEW' ? new Date().getFullYear() : oldKey;
  input.style.cssText = 'width:52px;font-family:var(--mono);font-size:11px;font-weight:600;background:var(--surface);border:1px solid var(--accent);border-radius:4px;color:var(--text);padding:2px 4px;outline:none;text-align:center;';
  btn.replaceWith(input);
  input.select();
  input.focus();
  var committed = false;

  function commit() {
    if (committed) return;
    committed = true;
    var newYear = parseInt(input.value);
    // If unchanged and not NEW, just restore the tab
    if (newYear === Number(oldKey) && oldKey !== 'NEW') { renderYearTabs(); return; }
    if (!newYear || newYear < 1900 || newYear > 2100) { cancelRename(); return; }
    if (entries[newYear] && String(newYear) !== String(oldKey)) {
      showToast('Year ' + newYear + ' already exists.', 'red');
      cancelRename(); return;
    }
    entries[newYear] = entries[oldKey] || [];
    delete entries[oldKey];
    currentYear = newYear;
    ensureAllIds();
    renderYearTabs();
    render();
    autosave();
  }

  function cancelRename() {
    committed = true;
    // Only delete if it was a NEW unsaved year
    if (oldKey === 'NEW' && entries['NEW']) { delete entries['NEW']; }
    renderYearTabs();
  }

  input.addEventListener('blur', commit);
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { input.blur(); }
    if (e.key === 'Escape') { input.removeEventListener('blur', commit); cancelRename(); }
  });
}






