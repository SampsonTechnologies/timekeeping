function undoSettings() {
  if (!settingsSnapshot) return;
  // Reverse any location renames (restores entry names too)
  while (locRenameLog.length) { const r = locRenameLog.pop(); applyLocationRename(r.to, r.from); }
  masterLocations = [...settingsSnapshot.masterLocations];
  masterDescriptions = [...settingsSnapshot.masterDescriptions];
  if (settingsSnapshot.defaultPayRate) defaultPayRate = settingsSnapshot.defaultPayRate;
  taxRate = settingsSnapshot.taxRate;
  deductionRate = settingsSnapshot.deductionRate;
  hideNetPay = settingsSnapshot.hideNetPay;
  document.getElementById('defaultPayRateInput').value = defaultPayRate;
  document.getElementById('taxRateInput').value = taxRate;
  document.getElementById('deductionRateInput').value = deductionRate || '';
  const toggle = document.getElementById('privacyToggle');
  const thumb = document.getElementById('privacyThumb');
  toggle.style.background = hideNetPay ? 'var(--accent)' : 'var(--border)';
  thumb.style.left = hideNetPay ? '18px' : '2px';
  // Restore deleted years (re-add empty entries object for any missing year)
  if (settingsSnapshot.entryYears) {
    settingsSnapshot.entryYears.forEach(y => {
      const key = isNaN(y) ? y : Number(y);
      if (!entries[key]) entries[key] = [];
    });
  }
  renderYearTabs();
  renderSettingsLists();
  renderContent();
}

function closeSettings() {
  const pr = parseFloat(document.getElementById('defaultPayRateInput').value);
  if (!isNaN(pr) && pr > 0) defaultPayRate = pr;
  const t = parseFloat(document.getElementById('taxRateInput').value);
  if (!isNaN(t) && t >= 0 && t <= 100) taxRate = t;
  const d = parseFloat(document.getElementById('deductionRateInput').value);
  if (!isNaN(d) && d >= 0 && d <= 100) deductionRate = d;
  const bri = document.getElementById('backupReminderInterval');
  if (bri) backupReminderDays = parseInt(bri.value);
  document.getElementById('settingsOverlay').classList.remove('open');
  document.getElementById('newLocInput').value = '';
  document.getElementById('newDescInput').value = '';
  renderContent();
  autosave();
}

function toggleHideNetPay() {
  hideNetPay = !hideNetPay;
