function updateEndFromHours() {
  const start = document.getElementById('fShiftStart').value.trim();
  const hrs = parseFloat(document.getElementById('fHours').value);
  if (start.length !== 4 || isNaN(hrs) || hrs <= 0) return;
  const startMins = parseInt(start.slice(0,2)) * 60 + parseInt(start.slice(2,4));
  const endMins = Math.round((startMins + hrs * 60)) % (24 * 60);
  const endH = String(Math.floor(endMins / 60)).padStart(2,'0');
  const endM = String(endMins % 60).padStart(2,'0');
  const endVal = endH + endM;
  document.getElementById('fShiftEnd').value = endVal;
  syncShiftDropdowns(endVal, 'fShiftEndHr', 'fShiftEndMin');
}

function calcHoursFromShift() {
  const start = document.getElementById('fShiftStart').value.trim();
  const end   = document.getElementById('fShiftEnd').value.trim();
  if (start.length !== 4 || end.length !== 4) return;
  const startMins = parseInt(start.slice(0,2)) * 60 + parseInt(start.slice(2,4));
  let   endMins   = parseInt(end.slice(0,2))   * 60 + parseInt(end.slice(2,4));
  if (isNaN(startMins) || isNaN(endMins)) return;
  if (endMins <= startMins) endMins += 24 * 60;
  const hrs = (endMins - startMins) / 60;
  if (hrs > 0 && hrs <= 24) {
    document.getElementById('fHours').value = hrs % 1 === 0 ? hrs : parseFloat(hrs.toFixed(2));
  }
}

