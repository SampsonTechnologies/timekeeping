    document.getElementById('monthScrollRight').style.opacity = hasOverflow && mf.scrollLeft < mf.scrollWidth - mf.clientWidth ? '1' : '0.2';
  }, 0);

  // Filter pay periods by selected month
  const filtered = sidebarMonth === 'ALL'
    ? pps
    : pps.filter(pp => pp.entries.length > 0 && pp.entries[0].date.slice(0, 7) === sidebarMonth);

  const MN2 = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  let html = '';
  let lastMonth = null;
  let monthRowCount = 0;

  filtered.forEach(pp => {
    const ppMonth = pp.entries[0]?.date?.slice(0, 7);
    const hrsClass = pp.needed === 0 ? 'over' : (pp.totalHrs < 30 ? 'under' : 'exact');
    const hrsLabel = pp.needed === 0 ? '+' + pp.ot.toFixed(1) + 'h' : '-' + pp.needed.toFixed(1) + 'h';
    const activeStyle = pp.idx === currentPP ? 'border-left-color:var(--accent);' : '';

