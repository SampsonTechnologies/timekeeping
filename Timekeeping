  pps.forEach(pp => { if (pp.entries.length > 0) monthSet.add(pp.entries[0].date.slice(0,7)); });
  const months = [...monthSet].sort();
  const MN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  document.getElementById('exportMonthCheckboxes').innerHTML = months.map(m => {
