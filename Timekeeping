function checkBackupReminder() {
  if (!backupReminderEnabled) return;
  const lastStr = localStorage.getItem('lastBackupDate');
  if (!lastStr) return; // Never backed up yet — don't nag on first open
  const last = parseInt(lastStr);
  const now = Date.now();
  const daysSince = (now - last) / (1000 * 60 * 60 * 24);
  // Also don't remind if there are no entries
  const hasEntries = Object.values(entries).some(yr => yr.length > 0);
  if (!hasEntries) return;
  // Check if snoozed
  const snoozedUntil = parseInt(localStorage.getItem('backupSnoozedUntil') || '0');
  if (now < snoozedUntil) return;
  if (daysSince >= backupReminderDays) {
    setTimeout(function() {
      const btn = document.getElementById('syncBtn');
      if (btn) { btn.classList.add('update-available'); btn.title = 'Backup overdue — click to back up'; }
      const banner = document.getElementById('backupBanner');
      if (banner) banner.style.display = 'flex';
    }, 1000);
  }
}

function snoozeBackupReminder() {
  // Snooze for 24 hours
  localStorage.setItem('backupSnoozedUntil', (Date.now() + 24 * 60 * 60 * 1000).toString());
  const banner = document.getElementById('backupBanner');
  if (banner) banner.style.display = 'none';
  const btn = document.getElementById('syncBtn');
  if (btn) { btn.classList.remove('update-available'); btn.title = 'Backup / Restore'; }
