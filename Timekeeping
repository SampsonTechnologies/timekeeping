// ── BACKUP REMINDER ─────────────────────────────────────────
let backupReminderEnabled = false;
let backupReminderDays = 7;

function toggleBackupReminder() {
  backupReminderEnabled = !backupReminderEnabled;
  const tog = document.getElementById('backupReminderToggle');
  const thumb = document.getElementById('backupReminderThumb');
  tog.style.background = backupReminderEnabled ? 'var(--accent)' : 'var(--border)';
